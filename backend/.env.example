# Copy to backend/.env and adjust. All settings are optional.
PROBELYN_OLLAMA_URL=http://localhost:11434
PROBELYN_CHAT_MODEL=llama3.2
PROBELYN_EMBED_MODEL=nomic-embed-text
PROBELYN_TEMPERATURE=0.2
# Where the SQLite database and uploads are stored
PROBELYN_DATA_DIR=data
# Retrieval
PROBELYN_CHUNK_SIZE=1000
PROBELYN_CHUNK_OVERLAP=200
PROBELYN_TOP_K=6
# Optional: free key from https://www.semanticscholar.org/product/api raises rate limits
# PROBELYN_SEMANTIC_SCHOLAR_API_KEY=
